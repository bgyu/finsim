# Rendered into private tmpfs by the slurmdbd role. The password is read from
# its credential file and never stored in this external non-secret template.
AuthType=auth/munge
@AUTH_CONFIGURATION@
@CONTROL_TLS_CONFIGURATION@
@DBD_HOST_CONFIGURATION@
DbdPort=6819
SlurmUser=slurm
DebugLevel=info
LogFile=/dev/stderr
PidFile=/run/slurm/pids/slurmdbd.pid

StorageType=accounting_storage/mysql
StorageHost=@STORAGE_HOST@
StoragePort=@STORAGE_PORT@
StorageLoc=@STORAGE_DATABASE@
StorageUser=@STORAGE_USER@
@STORAGE_CREDENTIAL@
@STORAGE_TLS_PARAMETERS@
