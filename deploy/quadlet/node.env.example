# Non-secret per-host role inputs. Never place credentials in this file.
FINSIM_CONFIG_REVISION=replace-with-generated-manifest-digest
SLURM_CONF_SERVER=controller-primary:6817,controller-backup:6817
SLURMD_FEATURE=finsim-worker
START_EMBEDDED_MUNGE=1
MUNGE_KEY_FILE=/run/secrets/munge.key
SLURM_TLS_CA_FILE=/run/secrets/ca.pem
SLURM_TLS_CERT_FILE=/run/secrets/role-cert.pem
SLURM_TLS_KEY_FILE=/run/secrets/role-key.pem
