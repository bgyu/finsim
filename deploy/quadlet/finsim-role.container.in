# Rendered only by scripts/render-production-unit.sh. Do not use envsubst:
# each multiline value is selected from a role-specific allow-list.
[Unit]
Description=FinSim @INSTANCE@ (@ROLE@) container
After=network-online.target remote-fs.target
Wants=network-online.target

[Container]
Image=@IMAGE@
ContainerName=finsim-@INSTANCE@
HostName=@INSTANCE@
Environment=CONTAINER_ROLE=@CONTAINER_ROLE@
Environment=CLUSTER_DEPLOYMENT_PROFILE=production
EnvironmentFile=/etc/finsim/roles/@INSTANCE@.env
Network=@NETWORK@
Pull=never
ReadOnly=true
ReadOnlyTmpfs=true
CgroupsMode=enabled
LogDriver=journald
@SECURITY_OPTIONS@
@HEALTH_COMMAND@
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
Notify=healthy
PidsLimit=4096
@ENVIRONMENT@
@CAPABILITIES@
@VOLUMES@
@EXEC@

[Service]
Delegate=yes
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
